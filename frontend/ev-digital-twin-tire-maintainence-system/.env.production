# Production environment - configure with your API endpoints
REACT_APP_API_URL=https://YOUR-ALB-DNS.us-east-1.elb.amazonaws.com
REACT_APP_LOGIN_TRACKER_API=https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com/prod

# Cognito configuration
REACT_APP_COGNITO_REGION=us-east-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_COGNITO_CLIENT_ID=YOUR_CLIENT_ID_HERE
REACT_APP_COGNITO_DOMAIN=YOUR-PROJECT-NAME.auth.us-east-1.amazoncognito.com

# AgentCore API endpoints
REACT_APP_AGENTCORE_API=https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com/chat
REACT_APP_TIRE_ORDER_API=https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com
