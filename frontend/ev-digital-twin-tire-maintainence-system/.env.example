# API Configuration
# After deploying the backend, update these with your API Gateway URLs

# AgentCore chat endpoint
REACT_APP_AGENTCORE_API=https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com/chat

# Tire order and other endpoints (same API Gateway, different routes)
REACT_APP_TIRE_ORDER_API=https://YOUR-API-GATEWAY-ID.execute-api.us-east-1.amazonaws.com

# Cognito configuration - update with your User Pool details
REACT_APP_COGNITO_REGION=us-east-1
REACT_APP_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
REACT_APP_COGNITO_CLIENT_ID=your-client-id-here
REACT_APP_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
