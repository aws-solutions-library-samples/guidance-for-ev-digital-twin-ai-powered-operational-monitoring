# EV Digital Twin - AWS Deployment Configuration
# Copy this file and customize for your deployment

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-account-id-here

# Application Configuration
APP_NAME=ev-digital-twin
ECR_REPO=ev-digital-twin-backend
IMAGE_TAG=latest

# ECS Configuration
ECS_CPU=1024
ECS_MEMORY=2048
ECS_DESIRED_COUNT=2

# Frontend Configuration
FRONTEND_DIR=frontend/ev-digital-twin-tire-maintainence-system

# Networking Configuration
VPC_CIDR=10.0.0.0/16
SUBNET1_CIDR=10.0.1.0/24
SUBNET2_CIDR=10.0.2.0/24

# CloudFront Configuration
CLOUDFRONT_PRICE_CLASS=PriceClass_100

# Optional: Custom Domain Configuration
# CUSTOM_DOMAIN=your-domain.com
# SSL_CERTIFICATE_ARN=arn:aws:acm:us-east-1:account:certificate/cert-id