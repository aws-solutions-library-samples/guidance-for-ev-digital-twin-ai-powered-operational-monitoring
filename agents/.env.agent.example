# Agent deployment configuration — copy to .env.agent and fill in your values
# This file is loaded by deploy-agent.sh before building

# Knowledge Base ID (required for KB tools)
KNOWLEDGE_BASE_ID=

# Bedrock model ID (required) — pick the inference profile you have access to
# Example: global.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL_ID=

# Browser Tool ID (required for tire ordering)
BROWSER_TOOL_ID=

# Guardrail config (optional)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=

# Specialist Agent ARNs (required for orchestrator only — set after deploying specialists)
TIRE_AGENT_ARN=
MOTOR_AGENT_ARN=
INVERTER_AGENT_ARN=
FLEET_AGENT_ARN=
